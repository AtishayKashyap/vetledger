# Runtime connection: the non-owner role that row-level security applies to.
DATABASE_URL=postgres://vetledger_app:app@localhost:5432/vetledger
# Owner connection, used only for migrations and seeding.
MIGRATION_DATABASE_URL=postgres://vetledger_owner:owner@localhost:5432/vetledger
REDIS_URL=redis://localhost:6379
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false
RUN_WORKER=true
# Optional: POST reminders to a webhook (e.g. https://webhook.site/...); otherwise logged.
REMINDER_WEBHOOK_URL=
# Optional: OTLP traces (Jaeger locally, Grafana Cloud free tier in prod)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
