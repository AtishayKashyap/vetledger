# Local development: the runtime URL already uses the non-owner role (RLS applies),
# and migrations use the owner role.
DATABASE_URL=postgres://vetledger_app:app@localhost:5432/vetledger
MIGRATION_DATABASE_URL=postgres://vetledger_owner:owner@localhost:5432/vetledger

# Neon (written by `neon env pull` / `neon deploy`): both URLs authenticate as the
# OWNER. Remove MIGRATION_DATABASE_URL above (it takes precedence), keep Neon's values,
# and set APP_DB_PASSWORD: migrations then create the non-owner role and the API
# connects to the pooled host as that role, so row-level security still applies.
# DATABASE_URL=postgresql://neondb_owner:...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# APP_DB_ROLE=vetledger_app
# APP_DB_PASSWORD=        # openssl rand -hex 24
REDIS_URL=redis://localhost:6379
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false
RUN_WORKER=true
# Optional: POST reminders to a webhook (e.g. https://webhook.site/...); otherwise logged.
REMINDER_WEBHOOK_URL=
# Optional: OTLP traces (Jaeger locally, Grafana Cloud free tier in prod)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
