{
  "name": "vetledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @vetledger/api migrate",
    "db:seed": "pnpm --filter @vetledger/api seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@neon/config": "1.14.4",
    "@neon/env": "2.1.7",
    "autocannon": "9.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0"
  }
}
