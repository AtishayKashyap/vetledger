{
  "name": "@vetledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "esbuild src/server.ts src/migrate.ts src/seed.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external --alias:@vetledger/shared=../../packages/shared/src/index.ts --sourcemap && cp -r src/migrations dist/",
    "start": "node --enable-source-maps dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@vetledger/shared": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.7.0",
    "cookie-parser": "1.4.7",
    "dataloader": "2.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "graphql": "16.14.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
